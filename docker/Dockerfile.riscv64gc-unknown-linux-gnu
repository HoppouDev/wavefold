# Same approach as Dockerfile.aarch64-unknown-linux-gnu, for riscv64gc -
# see install-multiarch-gst-dev.sh for why extraction is staged through
# a tar pipe with `--keep-directory-symlink` instead of a plain
# `apt-get install`.
#
# cross-rs's base image doesn't enable the riscv64 architecture on
# ports.ubuntu.com by default (only arm64/armhf) - add it explicitly.
# The grep after the sed makes a future non-match (e.g. the base image
# reordering or reformatting that line) a loud build failure here
# instead of a silent no-op that only surfaces later as a confusing
# "unable to locate package ...:riscv64" from apt.
FROM ghcr.io/cross-rs/riscv64gc-unknown-linux-gnu:main

RUN sed -i 's/^Architectures: arm64 armhf$/Architectures: arm64 armhf riscv64/' \
      /etc/apt/sources.list.d/ubuntu.sources && \
    grep -q '^Architectures: arm64 armhf riscv64$' /etc/apt/sources.list.d/ubuntu.sources

COPY docker/install-multiarch-gst-dev.sh /tmp/install-multiarch-gst-dev.sh
RUN /tmp/install-multiarch-gst-dev.sh riscv64 && rm /tmp/install-multiarch-gst-dev.sh
