# cross-rs base image for this target already carries the aarch64 GNU
# toolchain and has PKG_CONFIG_PATH/PKG_CONFIG_ALLOW_CROSS pointed at
# /usr/lib/aarch64-linux-gnu/pkgconfig - it's missing the actual GStreamer
# dev packages for that architecture, which install-multiarch-gst-dev.sh
# adds via Ubuntu's multiarch (ports.ubuntu.com) apt support. See that
# script for why it doesn't just `apt-get install` directly.
FROM ghcr.io/cross-rs/aarch64-unknown-linux-gnu:main

COPY docker/install-multiarch-gst-dev.sh /tmp/install-multiarch-gst-dev.sh
RUN /tmp/install-multiarch-gst-dev.sh arm64 && rm /tmp/install-multiarch-gst-dev.sh
